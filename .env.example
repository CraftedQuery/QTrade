# Copy to .env and fill in locally. .env is gitignored and must never be committed.
#
# PAPER TRADING ONLY.
# This project must never be configured with live brokerage credentials.
# There is deliberately no LIVE base URL or live key placeholder in this file.

# --- Alpaca paper trading (not used until Weeks 5-6) ---
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Lab runtime ---
LAB_ENV=dev
LAB_DATA_DIR=./data
LAB_ARTIFACT_DIR=./artifacts

# --- Risk limit overrides (optional) ---
# Highest-precedence layer: these win over configs/risk.yaml, which wins over
# the built-in defaults. Leave blank to use the file. Limits are read once at
# startup and never change mid-session; see src/lab/config.py.
LAB_RISK_STARTING_CAPITAL=
LAB_RISK_MAX_POSITION_WEIGHT=
LAB_RISK_MAX_GROSS_EXPOSURE=
LAB_RISK_MAX_POSITIONS=
LAB_RISK_MAX_DAILY_LOSS=
LAB_RISK_MAX_DRAWDOWN=
LAB_RISK_MAX_DATA_STALENESS_SECONDS=
LAB_RISK_OWNER_APPROVED=
